# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=$VERCEL_ORIGIN

# @type=string(minLength=1)
DATABASE_URL=

# System One decision layer: TypeSafe's Jev through OpenRouter. Server-only.
# Without a key the app still runs; housing-type site-fit ratings show as unavailable.
# @optional
OPENROUTER_API_KEY=

# Base URL of a /v1/systemone-compatible API (no path)
# @public @type=url
SYSTEM_ONE_BASE_URL=https://openrouter.ai/api

# Pinned so ratings don't shift mid-judging
# @public
SYSTEM_ONE_MODEL=jev-1.13

# Lane E chatbot. Optional: without it the chat pane falls back to deterministic notes. Server-only.
# @required=false @sensitive @type=string
GEMINI_API_KEY=
